{
  "name": "notechange",
  "version": "0.2.0-beta.2",
  "description": "Turn iCloud notes into beautifully formatted documents, recipes and chapters.",
  "main": "src/main.cjs",
  "author": "bhxuk",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "smoke": "electron . --smoke-test --disable-gpu"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "electron-updater": "^6.6.2",
    "image-size": "^2.0.4",
    "linkedom": "^0.18.12",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "uk.bhx.notechange",
    "productName": "NoteChange",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png",
      "LICENSE",
      "scripts/smoke.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NoteChange-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "bhxuk",
      "repo": "notechange",
      "releaseType": "prerelease"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/bhxuk/notechange",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhxuk/notechange.git"
  }
}
